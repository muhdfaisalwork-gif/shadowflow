# ============================================================================
# ShadowFlow — Production & Local Environment Configuration
# Deploy on Cloudflare Pages + Cloudflare Workers + Cloudflare D1
# ============================================================================

# 1. Worker API Origin (defaults to https://shadowflow.work in production)
VITE_WORKER_API_URL="https://shadowflow.work"

# 2. Paddle Billing (Client-side token prefixed with `live_` or `test_`)
# Set via Cloudflare Pages environment variables or local `.env` (never hard-code secrets)
VITE_PADDLE_CLIENT_TOKEN=""

# Note: Server-side Cloudflare Worker secrets are managed via `wrangler secret put`
# inside `worker/` and must never be committed to `.env*` files:
#   - JWT_SECRET
#   - ADMIN_EMAILS
#   - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   - GROQ_API_KEY
#   - RESEND_API_KEY
#   - PAYMENTS_PROVIDER="paddle"
#   - PAYMENTS_WEBHOOK_SECRET="<endpoint_secret_key from Paddle notification settings>"
